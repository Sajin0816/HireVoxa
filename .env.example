# Hirevoxa Environment Variables Reference

# Client Configuration
VITE_API_BASE_URL=http://localhost:5000/api

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (required outside the test suite)
# Supply your local MongoDB or MongoDB Atlas URI in your backend environment (.env).
# Do not commit real connection strings or credentials.
MONGODB_URI=<set-this-in-your-local-backend-environment>

# Local-only demonstration switch. Never enable this in production.
ALLOW_IN_MEMORY_DEMO=false
# Demo seed command requires a separate explicit opt-in.
ALLOW_DEMO_SEED=false
